rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A trip can only be opened by someone who knows its long random id (the private link).
    // Nobody can list all trips, and nobody can delete a whole trip from the app.
    match /trips/{tripId} {
      allow get, create, update: if tripId.size() >= 20;
      allow list, delete: if false;

      // Expenses, payments and receipt photos inside a trip.
      match /{sub}/{docId} {
        allow read, write: if tripId.size() >= 20
          && sub in ['expenses', 'payments', 'receipts', 'log'];
      }
    }
  }
}
